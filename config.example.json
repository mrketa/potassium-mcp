{
  "host": "127.0.0.1",
  "port": 32145,
  "proxyHost": "127.0.0.1",
  "proxyPort": 32146,
  "proxyMaxFrameBytes": 1048576,
  "proxyHandshakeTimeoutMs": 5000,
  "streamableHttpEnabled": false,
  "streamableHttpHost": "127.0.0.1",
  "streamableHttpPort": 32147,
  "statefulHttpEnabled": false,
  "tokenFile": "../workspace/.potassium-mcp-token",
  "requestTimeoutMs": 30000,
  "maxMessageBytes": 1048576,
  "maxPendingRequests": 64,
  "shutdownGraceMs": 5000,
  "allowUnsafeExecute": false,
  "hostPolicies": {
    "omp": { "read": true, "admin": true, "execute": false }
  },
  "httpPolicy": { "read": true, "admin": false, "execute": false },
  "builtinFallbackEnabled": false,
  "builtinFallbackTokenFile": "../workspace/.potassium-builtin-token",
  "adminAuditPath": "../workspace/potassium-mcp-admin-audit.ndjson",
  "artifactRoots": [
    {
      "name": "artifacts",
      "path": "../workspace/potassium-mcp-artifacts",
      "recursive": true,
      "extensions": [".json", ".ndjson", ".txt", ".log"]
    }
  ],
  "httpAllowedHosts": [
    "apis.roblox.com",
    "games.roblox.com",
    "thumbnails.roblox.com",
    "users.roblox.com"
  ]
}
